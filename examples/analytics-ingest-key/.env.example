# The Temps instance this demo sends analytics to. Point it at your own
# self-hosted instance or a Temps Cloud project. Include the /api/_temps
# suffix — that's the SDK's default ingest base path.
TEMPS_BASE_PATH=https://your-temps-instance.example.com/api/_temps

# Analytics ingest key for the target project. Not a secret — it's designed
# to be embedded in client-side JavaScript, and only grants analytics ingest
# for one project (optionally one environment). Mint one from the Console:
# Project -> Analytics -> Setup -> "Not hosted on Temps", or via the CLI:
#   bunx @temps-sdk/cli analytics keys create --project <project>
TEMPS_INGEST_KEY=pa_your_ingest_key_here

# Local port for this demo server.
PORT=4300
