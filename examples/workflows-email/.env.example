# Injected by Temps into every deployment; set them yourself only to run locally.
TEMPS_API_URL=https://your-temps-instance.example.com/api
TEMPS_API_TOKEN=

# The environment's workflow credential: console → project → environment → Workflows.
TEMPS_WORKFLOWS_TOKEN=

# Sender address. Its domain must be added under Email → Domains and allowed for
# this project; until the domain is verified, Temps captures the emails (visible
# under Email) instead of delivering them.
EMAIL_FROM=onboarding@mail.example.com
EMAIL_FROM_NAME=Workflows Email Example

# Enables /signup, /users/{id}/activate and /runs/{id}. Leave empty to disable them.
DEMO_API_KEY=
